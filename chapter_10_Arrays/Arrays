Arrays - is used to store multiples values in a single variable.
       - its collection of items.

// without array:
let user1 = "Admin";
let user2 = "Manager";
let user3 = "Tester";

syntax: let fruits = []; // empty array []

        let fruits = ["apple", "mango", "banana"];       
